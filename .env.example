# Copy to .env (ignored by git) and fill in. NEVER commit real values.

# --- LLM (MiniMax, endpoint OpenAI-compatible) ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_JUDGE_MODEL=MiniMax-M3      # the judge is a DIFFERENT model than the generator (avoids self-preference bias)

# --- Langfuse Cloud (US) ---
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# projeto: https://us.cloud.langfuse.com/project/cmuyh1njb00yxad0j2ixxfwnq

# --- App ---
DATABASE_URL=postgres://quizforge:quizforge@localhost:5433/quizforge
DEFAULT_SOURCE_URL=https://github.com/pipecat-ai/pipecat/blob/main/README.md
SOURCE_ALLOWED_HOSTS=github.com,raw.githubusercontent.com

# --- Worker / scorer (optional; these are the defaults) ---
# LLM_MODE=minimax                 # fake = deterministic fake model, no key needed
# SCORING_QUEUE_URL=               # where the worker sends score jobs; empty = quizzes are not scored
# JUDGE_SAMPLES=3                  # judge runs per quiz (median)
# ALLOWED_LANGUAGES=en,pt,es       # documents in any other language are rejected (can only narrow the set)
# INJECTION_DETECTOR=flag          # off | flag | block: Llama Prompt Guard 2 86M classifier (en, fr, de, hi, it, pt, es, th). Compose and AWS default: flag (needs the runtime-detector image)
# INJECTION_DETECTOR_MODULE=@quizforge/detector
# INJECTION_DETECTOR_MODEL_DIR=/models/prompt-guard-2   # local copy of the model (baked into the image); without it the model is downloaded from the Hugging Face hub (1.1 GB)
# INJECTION_DETECTOR_MODEL=gravitee-io/Llama-Prompt-Guard-2-86M-onnx
# INJECTION_DETECTOR_THRESHOLD=0.5  # malicious score (0..1) at or above which a window is flagged
