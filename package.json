{
  "name": "quizforge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:up": "docker compose up -d postgres elasticmq",
    "test:e2e": "tsx e2e/prepare.ts && playwright test --config e2e/playwright.config.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "prompts:lock": "pnpm --filter @quizforge/evals exec tsx src/publish-prompts.ts --write-lock",
    "prompts:publish": "pnpm --filter @quizforge/evals exec tsx src/publish-prompts.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@quizforge/db": "workspace:*",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "fast-check": "^3.23.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.0"
  }
}
